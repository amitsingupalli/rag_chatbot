# Google Gemini LLM (Primary Cloud Provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-2.0-flash

# Groq LLM (Cloud Fallback Provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# LlamaParse API Key
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here

# Ollama LLM (Local backup)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Embeddings: "huggingface" (for cloud) or "ollama" (for local)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Server
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
STREAMLIT_PORT=8501
BACKEND_URL=http://127.0.0.1:8000

# Data paths (relative to project root)
DATA_DIR=./data
STORAGE_DIR=./storage

# RAG tuning
CHUNK_SIZE=512
CHUNK_OVERLAP=64
SIMILARITY_TOP_K=5
RERANK_TOP_N=3
MEMORY_TOKEN_LIMIT=3900

# Web search (DuckDuckGo — no API key required)
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_FETCH_PAGES=true
WEB_FETCH_TOP_N=2
WEB_PAGE_MAX_CHARS=4000
